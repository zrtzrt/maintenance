<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_equipment_view_form" model="ir.ui.view">
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field
                    name="image_1920"
                    widget="image"
                    class="oe_avatar"
                    options='{"preview_image": "image_128"}'
                />
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_kanban" model="ir.ui.view">
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/div" position="before">
                <div class="o_kanban_image mr-1" style="position: absolute; right: 5px;">
                    <field name="image_128" widget="image" options="{'img_class': 'o_image_64_contain mw-100'}" alt="Equipment"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
