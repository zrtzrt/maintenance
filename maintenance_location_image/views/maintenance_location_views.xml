<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="maintenance_location_form_view" model="ir.ui.view">
        <field name="model">maintenance.location</field>
        <field name="inherit_id" ref="maintenance_location.maintenance_location_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field
                    name="image_1920"
                    widget="image"
                    class="oe_avatar"
                    options='{"preview_image": "image_128"}'
                />
            </xpath>
        </field>
    </record>
    
</odoo>